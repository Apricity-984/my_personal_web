{"config":{"lang":["zh","en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u9996\u9875","text":"<p> APRICITY \u00b7 PERSONAL FIELD NOTES</p> <p>A SPACE FOR SLOW GROWTH</p> <p>A\u2733</p> <p>Apricity</p> <p>\u5b66\u4e60 \u00b7 \u521b\u4f5c \u00b7 \u751f\u6d3b</p> <p>\u5199\u7ed9\u73b0\u5728\uff0c\u4e5f\u7559\u7ed9\u672a\u6765\u7684\u81ea\u5df1\u3002</p> <p>EXPLORE THE SITE</p> <ul> <li> <p>01 / TECH</p> <p>\u6280\u672f\u4e0e\u5b9e\u8df5</p> <p>\u7f16\u7a0b\u3001\u5de5\u5177\u548c\u9879\u76ee\u4e2d\u7684\u5c0f\u53d1\u73b0\u3002\u628a\u95ee\u9898\u89e3\u51b3\u7684\u8fc7\u7a0b\u4e5f\u8bb0\u4e0b\u6765\u3002</p> <p>\u6d4f\u89c8\u6280\u672f\u6587\u7ae0 \u2192</p> </li> <li> <p>02 / LEARNING</p> <p>\u5b66\u4e60\u4e0e\u7b14\u8bb0</p> <p>\u8bfe\u7a0b\u3001\u9605\u8bfb\u548c\u957f\u671f\u6574\u7406\u7684\u77e5\u8bc6\uff0c\u4ece\u96f6\u6563\u8f93\u5165\u5230\u81ea\u5df1\u7684\u7406\u89e3\u3002</p> <p>\u6253\u5f00\u5b66\u4e60\u7b14\u8bb0 \u2192</p> </li> <li> <p>03 / JOURNAL</p> <p>\u968f\u7b14\u4e0e\u60f3\u6cd5</p> <p>\u8bb0\u5f55\u751f\u6d3b\u91cc\u7684\u89c2\u5bdf\uff0c\u7ed9\u90a3\u4e9b\u6682\u65f6\u8fd8\u6ca1\u6709\u7b54\u6848\u7684\u95ee\u9898\u7559\u4e2a\u4f4d\u7f6e\u3002</p> <p>\u8bfb\u8bfb\u968f\u7b14 \u2192</p> </li> <li> <p>04 / WEEKLY</p> <p>\u6bcf\u5468\u6536\u85cf</p> <p>\u503c\u5f97\u4fdd\u5b58\u7684\u6587\u7ae0\u3001\u5de5\u5177\u4e0e\u7075\u611f\uff0c\u5076\u5c14\u56de\u5934\u770b\u770b\u81ea\u5df1\u8d70\u8fc7\u7684\u8def\u3002</p> <p>\u7ffb\u9605\u5468\u520a \u2192</p> </li> </ul> <p>A GOOD PLACE TO BEGIN</p> <p>\u201c</p> <p>KEEP IN TOUCH</p> <p>\u66f4\u591a\u5173\u4e8e\u6211 \u2192</p>"},{"location":"#_1","title":"\u628a\u6b63\u5728\u8d70\u7684\u8def\uff0c\u6162\u6162\u5199\u4e0b\u6765\u3002","text":"<p>\u4f60\u597d\uff0c\u6211\u662f Apricity\u3002\u8fd9\u91cc\u6536\u96c6\u6280\u672f\u5b9e\u8df5\u3001\u5b66\u4e60\u7b14\u8bb0\u3001\u8bfb\u4e66\u7247\u6bb5\u548c\u65e5\u5e38\u60f3\u6cd5\u3002\u5e0c\u671b\u6bcf\u4e00\u6b21\u8bb0\u5f55\uff0c\u90fd\u80fd\u8ba9\u4e0b\u4e00\u6b65\u8d70\u5f97\u66f4\u6e05\u695a\u4e00\u70b9\u3002</p> <p>\u901b\u901b\u535a\u5ba2 \u8ba4\u8bc6\u4e00\u4e0b\u6211</p>"},{"location":"#_2","title":"\u627e\u5230\u4f60\u611f\u5174\u8da3\u7684\u90a3\u4e00\u9875","text":""},{"location":"#_3","title":"\u4ece\u4e00\u4efd\u5b66\u4e60\u7b14\u8bb0\u5f00\u59cb","text":"<p>\u628a\u4e00\u4e2a\u95ee\u9898\u8bf4\u6e05\u695a\uff0c\u8bb0\u4e0b\u5c1d\u8bd5\u8fc7\u7684\u65b9\u6cd5\uff0c\u518d\u628a\u65b0\u7684\u53d1\u73b0\u4e32\u8054\u8d77\u6765\u3002</p> <p>\u6253\u5f00\u5b66\u4e60\u7b14\u8bb0 \u2192</p>"},{"location":"#_4","title":"\u4e0d\u79ef\u8dec\u6b65\uff0c\u65e0\u4ee5\u81f3\u5343\u91cc\u3002","text":"<p>\u6162\u6162\u6765\uff0c\u4f46\u4e00\u76f4\u5411\u524d\u3002</p>"},{"location":"#_5","title":"\u6b22\u8fce\u5728\u8fd9\u91cc\u76f8\u9047\u3002","text":"<p>\u5982\u679c\u4f60\u4e5f\u5bf9\u6280\u672f\u3001\u9605\u8bfb\u6216\u5b66\u4e60\u65b9\u6cd5\u611f\u5174\u8da3\uff0c\u53ef\u4ee5\u4ece\u6587\u7ae0\u5f00\u59cb\u901b\u8d77\u3002</p>"},{"location":"about/","title":"\u5173\u4e8e","text":"<p>\u4f60\u597d\uff0c\u6211\u662f Apricity\u3002</p> <p>\u8fd9\u4e2a\u7f51\u7ad9\u7528\u6765\u8bb0\u5f55\u6211\u6b63\u5728\u5b66\u4e60\u7684\u5185\u5bb9\u3001\u4e2a\u4eba\u9879\u76ee\u548c\u65e5\u5e38\u60f3\u6cd5\u3002</p>"},{"location":"about/#_2","title":"\u8054\u7cfb\u65b9\u5f0f","text":"<ul> <li>GitHub\uff1ahttps://github.com/Apricity-984</li> <li>\u90ae\u7bb1\uff1aw_th158350@163.com</li> </ul>"},{"location":"about/#_3","title":"\u672c\u7ad9","text":"<p>\u7f51\u7ad9\u4f7f\u7528 Markdown \u548c Material for MkDocs \u6784\u5efa\uff0c\u5185\u5bb9\u4ee5\u9759\u6001\u6587\u4ef6\u5f62\u5f0f\u53d1\u5e03\u3002</p>"},{"location":"blog/","title":"\u535a\u5ba2","text":"<p>\u6309\u4e3b\u9898\u6574\u7406\u7684\u6587\u7ae0\u548c\u968f\u7b14\u3002\u65b0\u6587\u7ae0\u5199\u6