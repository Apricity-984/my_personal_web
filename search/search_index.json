9\u4f5c"]},{"location":"blog/first-post/#_2","title":"\u53d1\u5e03","text":"<p>\u672c\u5730\u9884\u89c8\u786e\u8ba4\u540e\uff0c\u5c06\u4fee\u6539\u63a8\u9001\u5230 GitHub\uff1b\u914d\u7f6e\u597d Pages \u540e\uff0cGitHub Actions \u53ef\u4ee5\u81ea\u52a8\u6784\u5efa\u5e76\u53d1\u5e03\u7f51\u7ad9\u3002</p>","tags":["\u5efa\u7ad9","\u5199\u4f5c"]},{"location":"blog/technology/","title":"\u6280\u672f","text":"<p>\u8bb0\u5f55\u7f16\u7a0b\u3001\u8f6f\u4ef6\u5de5\u5177\u548c\u9879\u76ee\u5b9e\u8df5\u3002</p>"},{"location":"blog/technology/#_2","title":"\u6587\u7ae0","text":"<ul> <li>\u7ed9\u4e2a\u4eba\u535a\u5ba2\u9009\u4e00\u4e2a\u8f7b\u91cf\u7684\u5199\u4f5c\u6d41\u7a0b</li> </ul>"},{"location":"blog/weekly/","title":"\u5468\u520a","text":"<p>\u6bcf\u671f\u53ef\u4ee5\u6309\u6587\u7ae0\u3001\u5de5\u5177\u3001\u7f51\u7ad9\u3001\u4e66\u5f71\u97f3\u7b49\u4e3b\u9898\u6574\u7406\u6536\u85cf\u3002</p> <p>\u5efa\u8bae\u6bcf\u4e00\u671f\u5355\u72ec\u5efa\u4e00\u4e2a Markdown \u6587\u4ef6\uff0c\u4f8b\u5982 <code>week-01.md</code>\uff0c\u518d\u628a\u5b83\u52a0\u5165\u672c\u9875\u76ee\u5f55\u3002</p>"},{"location":"notes/","title":"\u7b14\u8bb0","text":"<p>\u628a\u53ef\u4ee5\u957f\u671f\u67e5\u9605\u7684\u5185\u5bb9\u653e\u5728\u8fd9\u91cc\uff0c\u6309\u4e3b\u9898\u62c6\u5206\u9875\u9762\uff0c\u540e\u7eed\u66f4\u5bb9\u6613\u8865\u5145\u548c\u68c0\u7d22\u3002</p> <ul> <li>\u9605\u8bfb</li> <li>\u5b66\u4e60</li> </ul>"},{"location":"notes/reading/","title":"\u9605\u8bfb","text":"<p>\u8bb0\u5f55\u8bfb\u4e66\u8fdb\u5ea6\u3001\u6458\u5f55\u3001\u95ee\u9898\u548c\u8bfb\u540e\u611f\u3002</p>"},{"location":"notes/reading/#_2","title":"\u9605\u8bfb\u8bb0\u5f55\u6a21\u677f","text":"<p>\u6bcf\u6b21\u65b0\u589e\u4e00\u672c\u4e66\u65f6\uff0c\u53ef\u4ee5\u590d\u5236\u4e0b\u9762\u7684\u5c0f\u8282\uff1a</p>"},{"location":"notes/reading/#_3","title":"\u4e66\u540d","text":"<ul> <li>\u4f5c\u8005\uff1a</li> <li>\u5f00\u59cb\u9605\u8bfb\uff1a</li> <li>\u72b6\u6001\uff1a\u5f85\u8bfb / \u5728\u8bfb / \u5df2